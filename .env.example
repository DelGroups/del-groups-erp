# ─── Del Groups ERP — Environment Variables ───────────────────────────────────
# Copy this file to `.env.local` for local development.
# On Vercel/VPS/Docker, set these in your hosting dashboard or `.env` file.

# Supabase project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key (safe for browser with RLS enabled)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase service role key — SERVER ONLY, never expose to browser
# Required for: user invites, backup/restore, warehouse slip admin reads
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Canonical site URL for auth redirects and invite links
# Production example: https://erp.delgroups.az
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Node environment (set automatically by host)
# NODE_ENV=production

# Optional AI copilot (server-only). Widget still works without keys via a live ERP snapshot.
# AI_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# Native ERP assistant on the Claude API (/api/ai/agent). Off unless AI_NATIVE_ENABLED=1.
# Uses ANTHROPIC_API_KEY above. AI_NATIVE_AUDIENCE: admins (default) or all.
# A model router picks Haiku / Sonnet / Opus per question; override a tier if needed.
# AI_NATIVE_ENABLED=0
# AI_NATIVE_AUDIENCE=admins
# AI_MODEL_FAST=claude-haiku-4-5
# AI_MODEL_STANDARD=claude-sonnet-5-5
# AI_MODEL_DEEP=claude-opus-5-5

# n8n AI Agent webhook (widget talks to /api/ai/n8n-bridge; secret stays server-side).
# Optional: leave empty and the assistant shows "not configured". ai.del-groups.com
# now belongs to DEL SOCIAL AI, so its old webhook URLs are treated as unset.
N8N_AI_WEBHOOK_URL=
N8N_AI_WEBHOOK_SECRET=your_n8n_webhook_secret

# n8n API key for managing n8n workflows and automation programmatically (server-only)
N8N_API_KEY=your_n8n_api_key

# ─── Multi-tenant mode (prompt 8) — leave ALL of these empty for single-tenant ──
# Empty (the default): one tenant from NEXT_PUBLIC_SUPABASE_* and
# SUPABASE_SERVICE_ROLE_KEY above, exactly as before.
# Set: the tenant is resolved from the request's domain through the control panel's
# Supabase project. Do NOT set these in production before the production domain is
# registered as a tenant in the control panel, or that domain will show "not found".
#
# Control panel's Supabase project URL (not an ERP / tenant project). Server only.
CONTROL_PLANE_URL=
# Control panel project's service-role key. Server only, never NEXT_PUBLIC_.
CONTROL_PLANE_SERVICE_ROLE_KEY=
# Shared random secret for the control panel's cache-invalidation webhook
# (/api/tenant/invalidate). Same value as TENANT_WEBHOOK_SECRET in control-panel/.env.local.
TENANT_WEBHOOK_SECRET=
# Docker only: a registered domain the container healthcheck loads /login for (in
# multi-tenant mode an unregistered host gets "not found"), e.g. erp.del-groups.com.
# Empty: the check uses 127.0.0.1:3000 as before. See docs/runbooks/tenant-1-cutover.md.
ERP_HEALTHCHECK_HOST=
# Settings → Billing for each tenant's administrators (prompt 13): plan, usage meters,
# invoices (PDF), upgrade/downgrade request. Only with "true" AND the control plane above;
# empty (the default) hides it. Read at build time (NEXT_PUBLIC_), so rebuild after changing it.
NEXT_PUBLIC_BILLING_PAGE_ENABLED=
