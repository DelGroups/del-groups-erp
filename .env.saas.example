# ─── Trial / SaaS ERP (erp-saas in docker-compose.saas.yml) — names only ──────────────────
# Copy to /opt/del-groups-erp/.env.saas on the server and fill in. This container serves
# <slug>.erp.del-groups.com for trial companies in MULTI-TENANT mode: every request's Host is
# looked up in the control panel, which hands over that tenant's own Supabase project.
#
# NEVER put the production project's keys here. In particular:
#   SUPABASE_SERVICE_ROLE_KEY      must NOT be in this file (that is erp.del-groups.com's).
#   NEXT_PUBLIC_SUPABASE_URL       must NOT be in this file.
#   NEXT_PUBLIC_SUPABASE_ANON_KEY  must NOT be in this file.
# The image is also built without them (docker-compose.saas.yml), so no production project is
# baked in. Runbook: docs/runbooks/saas-trial-stack.md.

# ── Multi-tenant mode (required) ─────────────────────────────────────────────
# The control panel's OWN Supabase project URL (not an ERP / tenant project). Server only.
CONTROL_PLANE_URL=
# That project's service-role key. Server only, never NEXT_PUBLIC_.
CONTROL_PLANE_SERVICE_ROLE_KEY=
# Shared random secret for the control panel's cache-invalidation webhook
# (/api/tenant/invalidate). The SAME value as TENANT_WEBHOOK_SECRET in .env.control-panel.
# Generate with: openssl rand -hex 32
TENANT_WEBHOOK_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────────
# The product domain the tenants live under (used for auth redirects and links when no tenant
# URL applies). Also read by docker-compose.saas.yml as the image's build arg.
NEXT_PUBLIC_SITE_URL=https://erp.del-groups.com

# ── Healthcheck ──────────────────────────────────────────────────────────────
# Leave EMPTY. docker-compose.saas.yml checks /api/tenant/health, which answers for any host
# without a tenant, so the container is healthy before the first trial company exists. (The
# Dockerfile's /login check with ERP_HEALTHCHECK_HOST is what production uses; here it is
# replaced by the compose healthcheck.)
ERP_HEALTHCHECK_HOST=

# ── Optional: the same feature flags as production, so trials see what Del Groups sees ──
# Copy the values from /opt/del-groups-erp/.env.production (names only listed here).
UI_STANDARD=
NEW_UI=
NEW_UI_AUDIENCE=
NEW_HOME=
NEW_HOME_AUDIENCE=
NEW_IMPORTS=
SETTINGS_V2=
UI_UNIFIED=
UI_UNIFIED_AUDIENCE=
NEW_CRM=
LIST_COLUMNS=
INVOICE_TOOLS=
COUNT_TEAM=
# Settings → Billing for tenant admins (needs the control plane above). Build-time
# (NEXT_PUBLIC_): the deploy rebuilds the image, so a change takes effect on the next deploy.
NEXT_PUBLIC_BILLING_PAGE_ENABLED=

# ── Optional: AI assistant (server only). Empty = off. Use keys meant for trials, not Del
# Groups' own. ──
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
AI_NATIVE_ENABLED=
AI_NATIVE_AUDIENCE=
