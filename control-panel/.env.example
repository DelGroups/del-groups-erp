# ─── Control panel — environment variables (names only) ──────────────────────
# Copy to control-panel/.env.local and fill in from the control panel's OWN
# Supabase project (Project Settings → API). Never use an ERP / tenant project here.

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key (safe in the browser; RLS lets only platform admins in)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
