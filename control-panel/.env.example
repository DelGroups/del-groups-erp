# ─── Control panel — environment variables (names only) ──────────────────────
# Copy to control-panel/.env.local and fill in from the control panel's OWN
# Supabase project (Project Settings → API). Never use an ERP / tenant project here.
#
# On the Hetzner VPS (trial stack, SAAS-1): the same names go into
# /opt/del-groups-erp/.env.control-panel (docs/runbooks/saas-trial-stack.md). There the two
# NEXT_PUBLIC_ values are also the image's build args (docker-compose.saas.yml), and:
#   TENANT_BASE_DOMAIN=erp.del-groups.com
#   ERP_TENANT_WEBHOOK_URL=http://erp-saas:3000/api/tenant/invalidate   (the trial ERP over
#     the docker network; never erp.del-groups.com, which is single-tenant)
#   TENANT_WEBHOOK_SECRET=<the same value as in .env.saas>
#   ERP_SQL_DIR and BILLING_FONT_DIR: leave empty (the image sets them).

# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# anon / publishable key (safe in the browser; RLS lets only platform admins in)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: tell the ERP right away when a tenant changes (otherwise its cache expires
# within 60 s). URL of the ERP's /api/tenant/invalidate, e.g.
# https://erp.example.com/api/tenant/invalidate, and the same random secret as the ERP's
# TENANT_WEBHOOK_SECRET (server only, never NEXT_PUBLIC_).
ERP_TENANT_WEBHOOK_URL=
TENANT_WEBHOOK_SECRET=

# ─── Provisioning (prompt 9): one-click creation of a tenant's ERP ─────────────
# Optional: without the first three, the tenant page explains what is missing instead of
# offering the "Create the ERP" button. Server only, never NEXT_PUBLIC_.
#
# Supabase personal access token (Account → Access Tokens) of an account that may create
# projects in the organization below. Never logged. On its own it also enables the
# "Migrate this tenant" button (tenant database migrations, prompt 10).
SUPABASE_MANAGEMENT_API_TOKEN=
# Organization slug the tenant projects are created in (Organization → Settings).
SUPABASE_ORG_SLUG=
# Tenants are served at <slug>.<TENANT_BASE_DOMAIN>, e.g. erp.example.com.
TENANT_BASE_DOMAIN=
# Supabase region group for new projects: emea (EU, default), americas or apac.
SUPABASE_REGION_GROUP=emea
# Where the ERP SQL lives (baseline/, modules/, migrations/). Default: ../supabase next to
# control-panel/ (the repo); the Docker image sets /app/supabase.
ERP_SQL_DIR=
#
# Custom SMTP for every tenant project's sign-in emails (invites, password resets), SAAS-2.
# Without it, tenants use Supabase's default email, which only reaches members of the
# Supabase organization, so a real company's admin never gets the invite (use "Copy invite
# link" on the tenant page then). Set all five or none: half-filled settings block
# provisioning. After setting them, press "Re-apply email settings" on existing tenants.
# Default target is Resend SMTP: host smtp.resend.com, port 465, user resend, password = a
# Resend API key (sending access), sender = an address on a domain verified in Resend.
TENANT_SMTP_HOST=
TENANT_SMTP_PORT=
TENANT_SMTP_USER=
TENANT_SMTP_PASS=
TENANT_SMTP_SENDER_EMAIL=
# Optional sender name; default "<company name> ERP".
TENANT_SMTP_SENDER_NAME=

# ─── Billing (prompt 13): invoices, payments and dunning ──────────────────────
# All optional; server only, never NEXT_PUBLIC_. Nothing is billed until an admin turns on
# "Bill this subscription automatically" for a tenant and the billing workflow is enabled.
#
# Billing emails (invoice, payment received, past due, read-only, suspended, reactivated).
# Without them the emails are recorded on the Billing page but not sent. Resend-style HTTP
# API; BILLING_EMAIL_API_URL points at another compatible service (default Resend).
BILLING_EMAIL_API_KEY=
BILLING_EMAIL_FROM=
BILLING_EMAIL_API_URL=
#
# The local card gateway (stub until its API docs are wired in). Without these, only bank
# transfer is offered.
CARD_GATEWAY_ID=
CARD_GATEWAY_API_URL=
CARD_GATEWAY_MERCHANT_ID=
CARD_GATEWAY_SECRET_KEY=
CARD_GATEWAY_WEBHOOK_SECRET=
#
# Service-role key of THIS control-panel project (Project Settings → API), used only by the
# payment webhook /api/payments/<gateway>/webhook, which has no signed-in admin.
CONTROL_PLANE_SERVICE_ROLE_KEY=
#
# Where the invoice fonts are (default: assets/fonts; the Docker image sets it).
BILLING_FONT_DIR=
